# OpenAI API Key (for LangChain)
OPENAI_API_KEY=your-openai-api-key-here

# Google AI API Key (for ADK and Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security Settings
SECRET_KEY=generate-a-strong-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Audit Database
DATABASE_URL=sqlite:///./audit_logs.db

# MCP Server Settings
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080

# A2A Agent Settings
A2A_AGENT_HOST=localhost
A2A_AGENT_PORT=8081

# Compliance Settings
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365
COMPLIANCE_MODE=strict  # strict, moderate, permissive

# PII Detection Settings
PII_DETECTION_ENABLED=true
PII_ANONYMIZATION_ENABLED=true

# Security Testing (for CI/CD)
PROMPTFOO_API_KEY=your-promptfoo-key-if-using-cloud
ENABLE_SECURITY_TESTS=true
