# Mobile Banking AI - Agent Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASS=secret
DB_NAME=mobilebanking

# OpenAI Configuration (required for LLM features)
OPENAI_API_KEY=your-openai-api-key-here

# Agent Ports
SUMMARY_AGENT_PORT=9001
TRANSFER_AGENT_PORT=9002
LOAN_AGENT_PORT=9003
INVEST_AGENT_PORT=9004
MCP_SERVER_PORT=9005

# LLM Model (optional, defaults to gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
